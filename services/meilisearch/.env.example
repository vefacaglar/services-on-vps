# Optional overrides. On the VPS every service reads the shared
# $VPS_DEPLOY_DIR/.env, so add these lines there to change the defaults.
# The master key is not set here: it comes from the MEILI_MASTER_KEY secret.
MEILI_HTTP_PORT=7700
MEILI_MEMORY_LIMIT=1g
MEILI_CPU_LIMIT=1.0
# Keep the indexing cap well below MEILI_MEMORY_LIMIT. Without it Meilisearch
# uses 2/3 of host RAM (not of the container limit). Units: bytes, Mb or Gb.
MEILI_MAX_INDEXING_MEMORY=512Mb
MEILI_MAX_INDEXING_THREADS=2
# Existing network shared with Caddy and the apps (same variable as logs).
LOGS_PROXY_NETWORK=databases_default
