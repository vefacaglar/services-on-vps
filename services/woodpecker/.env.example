# Optional overrides. On the VPS every service reads the shared
# $VPS_DEPLOY_DIR/.env, so add these lines there to change the defaults.
# Secrets are not set here: they come from the WOODPECKER_* GitHub secrets.
WOODPECKER_HTTP_PORT=8610
WOODPECKER_SERVER_MEMORY_LIMIT=256m
WOODPECKER_SERVER_CPU_LIMIT=0.5
WOODPECKER_AGENT_MEMORY_LIMIT=128m
WOODPECKER_AGENT_CPU_LIMIT=0.5
# Builds that run at the same time. Each one starts its own step containers.
WOODPECKER_MAX_WORKFLOWS=1
# Memory ceiling of a single build step container, in bytes (2 GiB). 0 = no limit.
WOODPECKER_STEP_MEMORY_BYTES=2147483648
WOODPECKER_LOG_LEVEL=info
# Docker daemon the agent starts build containers on (same variable as logs).
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Existing network shared with Caddy and the log console (same variable as logs).
LOGS_PROXY_NETWORK=databases_default
